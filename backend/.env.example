# Bloomberg Terminal Alternative - Environment Variables

# Gemini API Key (Required for AI Analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Alpha Vantage API Key (Optional - Free tier available)
ALPHA_VANTAGE_API_KEY=

# Finnhub API Key (Optional - Free tier available)
FINNHUB_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite:///./terminal.db
